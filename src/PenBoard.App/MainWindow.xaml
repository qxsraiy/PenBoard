<Window x:Class="PenBoard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PenBoard"
        Width="1280" Height="800"
        Left="0" Top="0"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Focusable="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="14">

    <Grid x:Name="Root" Background="{x:Null}">
        <Image x:Name="BackgroundImage"
               Stretch="Fill"
               IsHitTestVisible="False"
               RenderOptions.BitmapScalingMode="HighQuality" />

        <InkCanvas x:Name="InkCanvas"
                   Background="Transparent"
                   EditingMode="Ink"
                   Focusable="False"
                   Cursor="Cross"
                   StrokeCollected="InkCanvas_StrokeCollected" />

        <Border x:Name="TopBanner"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,16,0,0"
                Padding="18,8"
                CornerRadius="10"
                Background="#CC141414"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                IsHitTestVisible="False">
            <TextBlock x:Name="ModeText"
                       Text="输入模式"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#FFFFFFFF"
                       VerticalAlignment="Center" />
        </Border>

        <Border x:Name="CandidateBar"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,140"
                Padding="12,8"
                CornerRadius="12"
                Background="#F0141414"
                BorderBrush="#44FFFFFF"
                BorderThickness="1"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="候选"
                           Foreground="#AAFFFFFF"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="4,0,10,0" />
                <StackPanel x:Name="CandidatePanel" Orientation="Horizontal" />
            </StackPanel>
        </Border>

        <Border x:Name="Toolbar"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,72"
                Padding="8,6"
                CornerRadius="14"
                Background="#F0141414"
                BorderBrush="#44FFFFFF"
                BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="PenButton" Content="笔" Style="{StaticResource ToolButton}" Click="Pen_Click" />
                <Button x:Name="EraserButton" Content="涂抹擦" Style="{StaticResource ToolButton}" Click="Eraser_Click" />
                <Button x:Name="EraseStrokeButton" Content="整笔擦" Style="{StaticResource ToolButton}" Click="EraseStroke_Click" />

                <Border Width="1" Background="#44FFFFFF" Margin="8,4" />

                <Button x:Name="BlackButton" Style="{StaticResource ColorSwatchButton}" Background="#FF111111"
                        Tag="#FF111111" Click="Color_Click" ToolTip="黑色" AutomationProperties.Name="黑色" />
                <Button x:Name="RedButton" Style="{StaticResource ColorSwatchButton}" Background="#FFE53935"
                        Tag="#FFE53935" Click="Color_Click" ToolTip="红色" AutomationProperties.Name="红色" />
                <Button x:Name="BlueButton" Style="{StaticResource ColorSwatchButton}" Background="#FF1E88E5"
                        Tag="#FF1E88E5" Click="Color_Click" ToolTip="蓝色" AutomationProperties.Name="蓝色" />

                <Border Width="1" Background="#44FFFFFF" Margin="8,4" />

                <Button x:Name="ThinButton" Content="细" Style="{StaticResource ToolButton}" Tag="2" Click="Width_Click" />
                <Button x:Name="MediumButton" Content="中" Style="{StaticResource ToolButton}" Tag="4" Click="Width_Click" />
                <Button x:Name="ThickButton" Content="粗" Style="{StaticResource ToolButton}" Tag="8" Click="Width_Click" />

                <Border Width="1" Background="#44FFFFFF" Margin="8,4" />

                <Button x:Name="LanguageButton" Content="中" Style="{StaticResource ToolButton}" Click="Language_Click" ToolTip="中文 / English 识别切换" AutomationProperties.Name="识别语言" />
                <Button x:Name="BackspaceButton" Content="退格" Style="{StaticResource ToolButton}" Click="Backspace_Click" ToolTip="删除输入框里已识别的一个字符" />
                <Button Content="撤销" Style="{StaticResource ToolButton}" Click="Undo_Click" />
                <Button Content="清空" Style="{StaticResource ToolButton}" Click="Clear_Click" />
                <Button x:Name="SwitchInputButton" Content="切换输入"
                        Style="{StaticResource ToolButton}"
                        Click="SwitchInput_Click"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="切换到输入模式" />
                <Button x:Name="SwitchAnnotationButton" Content="切换批注"
                        Style="{StaticResource ToolButton}"
                        Click="SwitchAnnotation_Click"
                        ToolTip="切换到批注模式" />
                <Button x:Name="SaveButton" Content="保存" Style="{StaticResource ToolButton}" Click="Save_Click" Visibility="Collapsed" />
                <Button Content="关闭" Style="{StaticResource ToolButton}" Click="Close_Click" />
            </StackPanel>
        </Border>

        <Border x:Name="SavePromptBackdrop"
                Background="#66000000"
                Visibility="Collapsed"
                Panel.ZIndex="50">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="24,20"
                    CornerRadius="16"
                    Background="#F01A1A1A"
                    BorderBrush="#55FFFFFF"
                    BorderThickness="1">
                <StackPanel MinWidth="620">
                    <TextBlock x:Name="SavePromptTitle"
                               Text="保存批注"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFFFF" />
                    <TextBlock x:Name="SavePromptDetail"
                               Text="请选择保存格式（只保存一种）："
                               FontSize="13"
                               Foreground="#CCFFFFFF"
                               Margin="0,8,0,20"
                               TextWrapping="Wrap" />

                    <StackPanel x:Name="ClosePromptPanel"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Button Content="保存并关闭"
                                Style="{StaticResource ToolButton}"
                                Click="ClosePrompt_Save_Click"
                                Padding="16,8" />
                        <Button Content="舍弃并关闭"
                                Style="{StaticResource ToolButton}"
                                Click="ClosePrompt_Discard_Click"
                                Padding="16,8" />
                        <Button Content="取消"
                                Style="{StaticResource ToolButton}"
                                Click="ClosePrompt_Cancel_Click"
                                Padding="16,8" />
                    </StackPanel>

                    <StackPanel x:Name="FormatPromptPanel"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Visibility="Collapsed">
                        <Button Content="PNG"
                                Style="{StaticResource ToolButton}"
                                Click="FormatPng_Click"
                                Padding="22,8" />
                        <Button Content="PDF"
                                Style="{StaticResource ToolButton}"
                                Click="FormatPdf_Click"
                                Padding="22,8" />
                        <Button Content="取消"
                                Style="{StaticResource ToolButton}"
                                Click="FormatCancel_Click"
                                Padding="16,8" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <TextBlock x:Name="StatusText"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Margin="22,0,0,78"
                   FontSize="12"
                   Foreground="#E6FFFFFF"
                   IsHitTestVisible="False"
                   Text="">
        </TextBlock>
    </Grid>
</Window>
