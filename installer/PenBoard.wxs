<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package Name="PenBoard"
           Manufacturer="PenBoard"
           Version="0.1.14"
           Language="2052"
           UpgradeCode="CCFAFFE2-9C27-4F14-8540-9F4996565E3D"
           Scope="perUser"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of PenBoard is already installed."
                  AllowSameVersionUpgrades="no"
                  Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="PenBoardIcon" SourceFile="app.ico" />
    <Binary Id="PenBoardBanner" SourceFile="banner.bmp" />
    <Binary Id="SetupHelper" SourceFile="PenBoard.SetupHelper.arm64.exe" />
    <Property Id="ARPPRODUCTICON" Value="PenBoardIcon" />
    <Property Id="LAUNCHAPP" Value="1" />
    <Property Id="LAUNCHTEXT" Value="启动 PenBoard" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="PenBoard" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuDir" Name="PenBoard" />
    </StandardDirectory>

    <Feature Id="MainFeature" Title="PenBoard" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="StartupShortcut" />
    </Feature>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="..\artifacts\arm64\app\**" />
    </ComponentGroup>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="*">
        <Shortcut Id="DesktopShortcut"
                  Name="PenBoard"
                  Target="[INSTALLFOLDER]PenBoard.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="PenBoardIcon" />
        <RegistryValue Root="HKCU" Key="Software\PenBoard" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ProgramMenuDir">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="StartMenuShortcut"
                  Name="PenBoard"
                  Target="[INSTALLFOLDER]PenBoard.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="PenBoardIcon" />
        <RegistryValue Root="HKCU" Key="Software\PenBoard" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="StartupFolder">
      <Component Id="StartupShortcut" Guid="*">
        <Shortcut Id="StartupShortcut"
                  Name="PenBoard Startup"
                  Target="[INSTALLFOLDER]PenBoard.exe"
                  Arguments="--daemon"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="PenBoardIcon" />
        <RegistryValue Root="HKCU" Key="Software\PenBoard" Name="StartupShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <CustomAction Id="StopPenBoard"
                  BinaryRef="SetupHelper"
                  ExeCommand="stop"
                  Execute="immediate"
                  Return="ignore" />

    <CustomAction Id="CleanupOldZipInstall"
                  BinaryRef="SetupHelper"
                  ExeCommand="cleanup-old"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="ignore" />

    <CustomAction Id="UnblockInstalledFiles"
                  BinaryRef="SetupHelper"
                  ExeCommand="unblock"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="ignore" />

    <CustomAction Id="LaunchPenBoard"
                  BinaryRef="SetupHelper"
                  ExeCommand="launch"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="ignore" />

    <CustomAction Id="RemoveUserDataOnUninstall"
                  BinaryRef="SetupHelper"
                  ExeCommand="remove-user-data"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="StopPenBoard" Before="InstallInitialize" Condition="NOT Installed OR REMOVE" />
      <Custom Action="CleanupOldZipInstall" Before="InstallFiles" Condition="NOT Installed" />
      <Custom Action="UnblockInstalledFiles" After="InstallFiles" Condition="NOT Installed" />
      <Custom Action="LaunchPenBoard" After="InstallFinalize" Condition="NOT Installed AND LAUNCHAPP=1" />
      <Custom Action="RemoveUserDataOnUninstall" Before="InstallFinalize" Condition="REMOVE~=&quot;ALL&quot;" />
    </InstallExecuteSequence>

    <UI>
      <TextStyle Id="PenBoardFont" FaceName="Segoe UI" Size="9" />
      <Property Id="DefaultUIFont" Value="PenBoardFont" />
      <Property Id="SELECTED_LANG" Value="zh" />

      <Dialog Id="LanguageDlg" Width="370" Height="270" Title="PenBoard 0.1.14 Setup">
        <Control Id="Banner" Type="Bitmap" X="0" Y="0" Width="370" Height="58"
                 TabSkip="no" Text="PenBoardBanner" />
        <Control Id="Title" Type="Text" X="20" Y="72" Width="330" Height="24"
                 Transparent="yes" NoPrefix="yes" Text="PenBoard 0.1.14" />
        <Control Id="Description" Type="Text" X="20" Y="105" Width="330" Height="24"
                 Transparent="yes" NoPrefix="yes"
                 Text="选择安装语言 / Select setup language" />
        <Control Id="Chinese" Type="PushButton" X="55" Y="150" Width="110" Height="30"
                 Default="yes" Text="中文">
          <Publish Property="SELECTED_LANG" Value="zh" Order="1" />
          <Publish Property="LAUNCHTEXT" Value="启动 PenBoard" Order="2" />
          <Publish Event="NewDialog" Value="WelcomeDlg" Order="3" />
        </Control>
        <Control Id="English" Type="PushButton" X="205" Y="150" Width="110" Height="30"
                 Text="English">
          <Publish Property="SELECTED_LANG" Value="en" Order="1" />
          <Publish Property="LAUNCHTEXT" Value="Launch PenBoard" Order="2" />
          <Publish Event="NewDialog" Value="WelcomeDlg" Order="3" />
        </Control>
        <Control Id="CancelZh" Type="PushButton" X="304" Y="243" Width="56" Height="17"
                 Cancel="yes" Text="取消" Hidden="yes"
                 ShowCondition="SELECTED_LANG=&quot;zh&quot;">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="CancelEn" Type="PushButton" X="304" Y="243" Width="56" Height="17"
                 Cancel="yes" Text="Cancel" Hidden="yes"
                 ShowCondition="SELECTED_LANG=&quot;en&quot;">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <Dialog Id="WelcomeDlg" Width="370" Height="270" Title="PenBoard 0.1.14 Setup">
        <Control Id="Banner" Type="Bitmap" X="0" Y="0" Width="370" Height="58"
                 TabSkip="no" Text="PenBoardBanner" />
        <Control Id="TitleZh" Type="Text" X="20" Y="72" Width="330" Height="24"
                 Transparent="yes" NoPrefix="yes" Hidden="yes" Text="欢迎使用 PenBoard 安装程序"
                 ShowCondition="SELECTED_LANG=&quot;zh&quot;" />
        <Control Id="TitleEn" Type="Text" X="20" Y="72" Width="330" Height="24"
                 Transparent="yes" NoPrefix="yes" Hidden="yes" Text="Welcome to PenBoard Setup"
                 ShowCondition="SELECTED_LANG=&quot;en&quot;" />
        <Control Id="DescZh" Type="Text" X="20" Y="110" Width="330" Height="110"
                 Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="将安装 PenBoard 0.1.14 到：&#xA;%LOCALAPPDATA%\Programs\PenBoard&#xA;&#xA;不需要管理员权限。&#xA;卸载时会删除设置和日志，保留“图片\PenBoard”。"
                 ShowCondition="SELECTED_LANG=&quot;zh&quot;" />
        <Control Id="DescEn" Type="Text" X="20" Y="110" Width="330" Height="110"
                 Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="This will install PenBoard 0.1.14 to:&#xA;%LOCALAPPDATA%\Programs\PenBoard&#xA;&#xA;No administrator rights are required.&#xA;Uninstall removes settings and logs, but keeps Pictures\PenBoard."
                 ShowCondition="SELECTED_LANG=&quot;en&quot;" />
        <Control Id="InstallZh" Type="PushButton" X="236" Y="243" Width="56" Height="17"
                 Default="yes" Text="安装" Hidden="yes"
                 ShowCondition="SELECTED_LANG=&quot;zh&quot;">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="InstallEn" Type="PushButton" X="236" Y="243" Width="56" Height="17"
                 Default="yes" Text="Install" Hidden="yes"
                 ShowCondition="SELECTED_LANG=&quot;en&quot;">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="BackZh" Type="PushButton" X="180" Y="243" Width="56" Height="17"
                 Text="返回" Hidden="yes" ShowCondition="SELECTED_LANG=&quot;zh&quot;">
          <Publish Event="NewDialog" Value="LanguageDlg" />
        </Control>
        <Control Id="BackEn" Type="PushButton" X="180" Y="243" Width="56" Height="17"
                 Text="Back" Hidden="yes" ShowCondition="SELECTED_LANG=&quot;en&quot;">
          <Publish Event="NewDialog" Value="LanguageDlg" />
        </Control>
        <Control Id="CancelZh" Type="PushButton" X="304" Y="243" Width="56" Height="17"
                 Cancel="yes" Text="取消" Hidden="yes" ShowCondition="SELECTED_LANG=&quot;zh&quot;">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="CancelEn" Type="PushButton" X="304" Y="243" Width="56" Height="17"
                 Cancel="yes" Text="Cancel" Hidden="yes" ShowCondition="SELECTED_LANG=&quot;en&quot;">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <Dialog Id="ProgressDlg" Width="370" Height="270" Title="PenBoard Setup"
              Modeless="yes">
        <Control Id="Banner" Type="Bitmap" X="0" Y="0" Width="370" Height="58"
                 TabSkip="no" Text="PenBoardBanner" />
        <Control Id="TitleZh" Type="Text" X="20" Y="72" Width="330" Height="24"
                 Transparent="yes" NoPrefix="yes" Hidden="yes" Text="正在安装 PenBoard"
                 ShowCondition="SELECTED_LANG=&quot;zh&quot;" />
        <Control Id="TitleEn" Type="Text" X="20" Y="72" Width="330" Height="24"
                 Transparent="yes" NoPrefix="yes" Hidden="yes" Text="Installing PenBoard"
                 ShowCondition="SELECTED_LANG=&quot;en&quot;" />
        <Control Id="WaitZh" Type="Text" X="20" Y="105" Width="330" Height="20"
                 Transparent="yes" NoPrefix="yes" Hidden="yes" Text="请稍候…"
                 ShowCondition="SELECTED_LANG=&quot;zh&quot;" />
        <Control Id="WaitEn" Type="Text" X="20" Y="105" Width="330" Height="20"
                 Transparent="yes" NoPrefix="yes" Hidden="yes" Text="Please wait…"
                 ShowCondition="SELECTED_LANG=&quot;en&quot;" />
        <Control Id="ActionText" Type="Text" X="20" Y="140" Width="330" Height="15">
          <Subscribe Event="ActionText" Attribute="Text" />
        </Control>
        <Control Id="ProgressBar" Type="ProgressBar" X="20" Y="160" Width="330" Height="10"
                 ProgressBlocks="yes" Text="%">
          <Subscribe Event="SetProgress" Attribute="Progress" />
        </Control>
        <Control Id="CancelZh" Type="PushButton" X="304" Y="243" Width="56" Height="17"
                 Cancel="yes" Text="取消" Hidden="yes" ShowCondition="SELECTED_LANG=&quot;zh&quot;">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="CancelEn" Type="PushButton" X="304" Y="243" Width="56" Height="17"
                 Cancel="yes" Text="Cancel" Hidden="yes" ShowCondition="SELECTED_LANG=&quot;en&quot;">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <Dialog Id="ExitDialog" Width="370" Height="270" Title="PenBoard 0.1.14 Setup">
        <Control Id="Banner" Type="Bitmap" X="0" Y="0" Width="370" Height="58"
                 TabSkip="no" Text="PenBoardBanner" />
        <Control Id="TitleZh" Type="Text" X="20" Y="72" Width="330" Height="24"
                 Transparent="yes" NoPrefix="yes" Hidden="yes" Text="PenBoard 安装完成"
                 ShowCondition="SELECTED_LANG=&quot;zh&quot;" />
        <Control Id="TitleEn" Type="Text" X="20" Y="72" Width="330" Height="24"
                 Transparent="yes" NoPrefix="yes" Hidden="yes" Text="PenBoard Setup Complete"
                 ShowCondition="SELECTED_LANG=&quot;en&quot;" />
        <Control Id="DescZh" Type="Text" X="20" Y="110" Width="330" Height="70"
                 Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="现在可以双击笔按钮，或按 Ctrl+Alt+P 测试。"
                 ShowCondition="SELECTED_LANG=&quot;zh&quot;" />
        <Control Id="DescEn" Type="Text" X="20" Y="110" Width="330" Height="70"
                 Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="You can now double-tap the pen button or press Ctrl+Alt+P to test."
                 ShowCondition="SELECTED_LANG=&quot;en&quot;" />
        <Control Id="Launch" Type="CheckBox" X="20" Y="185" Width="320" Height="18"
                 Property="LAUNCHAPP" CheckBoxValue="1"
                 Text="[LAUNCHTEXT]" />
        <Control Id="FinishZh" Type="PushButton" X="236" Y="243" Width="56" Height="17"
                 Default="yes" Text="完成" Hidden="yes"
                 ShowCondition="SELECTED_LANG=&quot;zh&quot;">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="FinishEn" Type="PushButton" X="236" Y="243" Width="56" Height="17"
                 Default="yes" Text="Finish" Hidden="yes"
                 ShowCondition="SELECTED_LANG=&quot;en&quot;">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <Dialog Id="CancelDlg" Width="260" Height="120" Title="PenBoard Setup">
        <Control Id="TextZh" Type="Text" X="15" Y="18" Width="230" Height="30"
                 Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="确定取消安装？" ShowCondition="SELECTED_LANG=&quot;zh&quot;" />
        <Control Id="TextEn" Type="Text" X="15" Y="18" Width="230" Height="30"
                 Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="Cancel setup?" ShowCondition="SELECTED_LANG=&quot;en&quot;" />
        <Control Id="YesZh" Type="PushButton" X="100" Y="80" Width="60" Height="18"
                 Default="yes" Text="是" Hidden="yes" ShowCondition="SELECTED_LANG=&quot;zh&quot;">
          <Publish Event="EndDialog" Value="Cancel" />
        </Control>
        <Control Id="YesEn" Type="PushButton" X="100" Y="80" Width="60" Height="18"
                 Default="yes" Text="Yes" Hidden="yes" ShowCondition="SELECTED_LANG=&quot;en&quot;">
          <Publish Event="EndDialog" Value="Cancel" />
        </Control>
        <Control Id="NoZh" Type="PushButton" X="170" Y="80" Width="60" Height="18"
                 Cancel="yes" Text="否" Hidden="yes" ShowCondition="SELECTED_LANG=&quot;zh&quot;">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="NoEn" Type="PushButton" X="170" Y="80" Width="60" Height="18"
                 Cancel="yes" Text="No" Hidden="yes" ShowCondition="SELECTED_LANG=&quot;en&quot;">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <InstallUISequence>
        <Custom Action="StopPenBoard" Before="ProgressDlg" />
        <Show Dialog="LanguageDlg" Before="ProgressDlg" Condition="NOT Installed" />
        <Show Dialog="ProgressDlg" Before="ExecuteAction" Condition="NOT Installed OR REMOVE" />
        <Show Dialog="ExitDialog" OnExit="success" Condition="NOT Installed OR REMOVE" />
      </InstallUISequence>
    </UI>

  </Package>
</Wix>
